# ==============================================================================
# Sentinel API — variáveis de ambiente
# Copie este arquivo para "api/.env" e preencha os valores.
# NUNCA faça commit do arquivo .env.
# ==============================================================================

# Banco de dados PostgreSQL (usado pelo Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinel"

# Segredo de assinatura do JWT (use um valor longo e aleatório em produção)
JWT_SECRET="troque-por-um-segredo-forte"

# Porta HTTP da API
PORT=3000

# URL do frontend (origem liberada no CORS e destino do redirect pós-login Google)
FRONTEND_URL="http://localhost:5173"

# Login com Google (opcional) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"