generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?  @map("password_hash")
  provider     String?  @default("local")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  agentTokens AgentToken[]
  computers   Computer[]

  @@map("users")
}

model AgentToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  name      String?  @default("Agente Principal")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_tokens")
}

model Computer {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  machineId    String    @map("machine_id")
  hostname     String
  osInfo       String?   @map("os_info")
  agentVersion String?   @map("agent_version")
  lastPing     DateTime? @map("last_ping") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics Metric[]

  @@unique([userId, machineId], name: "unique_user_machine")
  @@map("computers")
}

model Metric {
  id              BigInt   @id @default(autoincrement())
  computerId      String   @map("computer_id") @db.Uuid
  cpuUsagePercent Decimal  @map("cpu_usage_percent") @db.Decimal(5, 2)
  ramTotalBytes   BigInt   @map("ram_total_bytes")
  ramUsedBytes    BigInt   @map("ram_used_bytes")
  ramUsagePercent Decimal  @map("ram_usage_percent") @db.Decimal(5, 2)
  disks           Json     @db.JsonB
  collectedAt     DateTime @map("collected_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  computer Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)

  @@index([computerId, collectedAt(sort: Desc)], map: "idx_metrics_computer_time")
  @@map("metrics")
}
